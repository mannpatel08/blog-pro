<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar', { activePage: 'profile' }) %>

          <div class="content-wrapper">
            <div class="row">
              <div class="col-md-12 grid-margin">
                <div class="row">
                  <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                    <h3 class="font-weight-bold">My Profile</h3>
                    <h6 class="font-weight-normal mb-0">Admin account details</h6>
                  </div>
                </div>
              </div>
            </div>

            <!-- Flash Messages -->
            <% if (success_msg && success_msg.length > 0) { %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>
            <% if (error_msg && error_msg.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <div class="row">
              <div class="col-12 grid-margin stretch-card">
                <div class="card card-rounded">
                  <div class="card-body">
                    <div class="row">
                      <div class="col-md-4 text-center">
                        <div class="mb-4">
                          <% if (admin && admin.image && admin.image !== 'default-avatar.png') { %>
                            <img src="/uploads/<%= admin.image %>" alt="Profile" class="img-fluid rounded-circle" style="width:150px;height:150px;object-fit:cover;">
                          <% } else { %>
                            <img src="/images/faces/face8.jpg" alt="Profile" class="img-fluid rounded-circle" style="width:150px;height:150px;object-fit:cover;">
                          <% } %>
                        </div>
                        <h4 class="fw-bold"><%= admin ? admin.name : 'Admin' %></h4>
                        <p class="text-muted"><%= admin ? admin.email : '' %></p>
                        <a href="/edit-admin/<%= admin ? admin._id : '' %>" class="btn btn-primary btn-sm">Edit Profile</a>
                      </div>
                      <div class="col-md-8">
                        <div class="card card-rounded border">
                          <div class="card-body">
                            <h5 class="card-title card-title-dash mb-4">Account Information</h5>
                            <div class="row mb-3">
                              <div class="col-sm-4">
                                <p class="mb-0 fw-semibold text-muted">Full Name</p>
                              </div>
                              <div class="col-sm-8">
                                <p class="mb-0"><%= admin ? admin.name : 'N/A' %></p>
                              </div>
                            </div>
                            <hr>
                            <div class="row mb-3">
                              <div class="col-sm-4">
                                <p class="mb-0 fw-semibold text-muted">Email Address</p>
                              </div>
                              <div class="col-sm-8">
                                <p class="mb-0"><%= admin ? admin.email : 'N/A' %></p>
                              </div>
                            </div>
                            <hr>
                            <div class="row mb-3">
                              <div class="col-sm-4">
                                <p class="mb-0 fw-semibold text-muted">Account Created</p>
                              </div>
                              <div class="col-sm-8">
                                <p class="mb-0"><%= admin && admin.createdAt ? admin.createdAt.toDateString() : 'N/A' %></p>
                              </div>
                            </div>
                            <hr>
                            <div class="row mb-3">
                              <div class="col-sm-4">
                                <p class="mb-0 fw-semibold text-muted">Role</p>
                              </div>
                              <div class="col-sm-8">
                                <div class="badge badge-opacity-success">Administrator</div>
                              </div>
                            </div>
                            <hr>
                            <div class="row mb-3">
                              <div class="col-sm-4">
                                <p class="mb-0 fw-semibold text-muted">Status</p>
                              </div>
                              <div class="col-sm-8">
                                <div class="badge badge-opacity-success">Active</div>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="mt-3">
                          <a href="/edit-admin/<%= admin ? admin._id : '' %>" class="btn btn-primary me-2">
                            <i class="mdi mdi-pencil me-1"></i>Edit Profile
                          </a>
                          <a href="/dashboard" class="btn btn-outline-secondary">
                            <i class="mdi mdi-arrow-left me-1"></i>Back to Dashboard
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

<%- include('partials/footer') %>
