<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar', { activePage: 'view-admin' }) %>

          <div class="content-wrapper">
            <div class="row">
              <div class="col-md-12 grid-margin">
                <div class="row">
                  <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                    <h3 class="font-weight-bold">View All Admins</h3>
                    <h6 class="font-weight-normal mb-0">All registered admin accounts</h6>
                  </div>
                  <div class="col-12 col-xl-4 text-end">
                    <a href="/add-admin" class="btn btn-primary">
                      <i class="mdi mdi-account-plus me-1"></i>Add New Admin
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Flash Messages -->
            <% if (success_msg && success_msg.length > 0) { %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>
            <% if (error_msg && error_msg.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <div class="row">
              <div class="col-12 grid-margin stretch-card">
                <div class="card card-rounded">
                  <div class="card-body">
                    <div class="d-sm-flex justify-content-between align-items-start mb-3">
                      <div>
                        <h4 class="card-title card-title-dash">Admin List</h4>
                        <p class="card-subtitle card-subtitle-dash">Total: <strong><%= admins.length %></strong> admins registered</p>
                      </div>
                    </div>
                    <div class="table-responsive">
                      <table class="table select-table">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Admin</th>
                            <th>Email</th>
                            <th>Joined Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (admins && admins.length > 0) { %>
                            <% admins.forEach(function(a, i) { %>
                              <tr>
                                <td><%= i + 1 %></td>
                                <td>
                                  <div class="d-flex align-items-center">
                                    <% if (a.image && a.image !== 'default-avatar.png') { %>
                                      <img src="/uploads/<%= a.image %>" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;margin-right:10px;">
                                    <% } else { %>
                                      <img src="/images/faces/face1.jpg" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;margin-right:10px;">
                                    <% } %>
                                    <div>
                                      <h6 class="mb-0"><%= a.name %></h6>
                                      <% if (admin && a._id.toString() === admin._id.toString()) { %>
                                        <span class="badge badge-opacity-primary" style="font-size:10px;">You</span>
                                      <% } %>
                                    </div>
                                  </div>
                                </td>
                                <td><%= a.email %></td>
                                <td><%= a.createdAt ? a.createdAt.toDateString() : 'N/A' %></td>
                                <td><div class="badge badge-opacity-success">Active</div></td>
                                <td>
                                  <a href="/edit-admin/<%= a._id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="mdi mdi-pencil"></i> Edit
                                  </a>
                                  <% if (admin && a._id.toString() !== admin._id.toString()) { %>
                                    <form action="/delete-admin/<%= a._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this admin?')">
                                      <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="mdi mdi-delete"></i> Delete
                                      </button>
                                    </form>
                                  <% } else { %>
                                    <button class="btn btn-sm btn-outline-secondary" disabled title="Cannot delete your own account">
                                      <i class="mdi mdi-delete"></i> Delete
                                    </button>
                                  <% } %>
                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="6" class="text-center py-4">
                                <i class="mdi mdi-account-off mdi-48px text-muted"></i>
                                <p class="mt-2">No admins found. <a href="/add-admin">Add the first admin</a>.</p>
                              </td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

<%- include('partials/footer') %>
