<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar', { activePage: 'edit-admin' }) %>

          <div class="content-wrapper">
            <div class="row">
              <div class="col-md-12 grid-margin">
                <div class="row">
                  <div class="col-12 col-xl-8 mb-4 mb-xl-0">
                    <h3 class="font-weight-bold">Edit Admin</h3>
                    <h6 class="font-weight-normal mb-0">Update admin account information</h6>
                  </div>
                </div>
              </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
              <% errors.forEach(function(err){ %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <%= err.msg %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
              <% }) %>
            <% } %>
            <% if (success_msg && success_msg.length > 0) { %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>
            <% if (error_msg && error_msg.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <div class="row">
              <div class="col-12 grid-margin stretch-card">
                <div class="card card-rounded">
                  <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                      <% if (editAdmin.image && editAdmin.image !== 'default-avatar.png') { %>
                        <img src="/uploads/<%= editAdmin.image %>" alt="Profile" class="rounded-circle me-3" style="width:70px;height:70px;object-fit:cover;">
                      <% } else { %>
                        <img src="/images/faces/face8.jpg" alt="Profile" class="rounded-circle me-3" style="width:70px;height:70px;object-fit:cover;">
                      <% } %>
                      <div>
                        <h4 class="card-title card-title-dash mb-0"><%= editAdmin.name %></h4>
                        <p class="text-muted mb-0"><%= editAdmin.email %></p>
                      </div>
                    </div>
                    <form action="/edit-admin/<%= editAdmin._id %>" method="POST" enctype="multipart/form-data">
                      <div class="row">
                        <div class="col-md-6">
                          <div class="form-group mb-3">
                            <label for="editName" class="form-label">Full Name *</label>
                            <input type="text" class="form-control form-control-lg" id="editName" name="name" value="<%= editAdmin.name %>" required>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group mb-3">
                            <label for="editEmail" class="form-label">Email Address *</label>
                            <input type="email" class="form-control form-control-lg" id="editEmail" name="email" value="<%= editAdmin.email %>" required>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group mb-3">
                            <label for="editPassword" class="form-label">New Password <small class="text-muted">(leave blank to keep current)</small></label>
                            <input type="password" class="form-control form-control-lg" id="editPassword" name="password" placeholder="Enter new password (min 6 chars)">
                          </div>
                        </div>
                        <div class="col-md-6">
                          <div class="form-group mb-3">
                            <label for="editImage" class="form-label">Profile Image <small class="text-muted">(leave blank to keep current)</small></label>
                            <input type="file" class="form-control form-control-lg" id="editImage" name="image" accept="image/*">
                            <% if (editAdmin.image && editAdmin.image !== 'default-avatar.png') { %>
                              <small class="text-muted">Current: <%= editAdmin.image %></small>
                            <% } %>
                          </div>
                        </div>
                      </div>
                      <div class="mt-4">
                        <button type="submit" class="btn btn-primary btn-lg me-2">
                          <i class="mdi mdi-content-save me-1"></i>Update Admin
                        </button>
                        <a href="/view-admin" class="btn btn-outline-secondary btn-lg">
                          <i class="mdi mdi-arrow-left me-1"></i>Back to List
                        </a>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          </div>

<%- include('partials/footer') %>
